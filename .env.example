# ARGUS Environment Configuration Example
# Copy this file to .env or .env.local to configure your local setup.

# Database Configuration (PostgreSQL with PostGIS in Docker, or local fallback)
DATABASE_URL=postgresql+psycopg://argus:argus_secure_password@localhost:5433/argus_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI Computer Vision Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.25
MODEL_STORAGE_PATH=backend/ai_service/weights
UPLOAD_STORAGE_PATH=backend/uploads

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
